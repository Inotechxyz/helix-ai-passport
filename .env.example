# Copy to .env (which is git-ignored) and fill in local values.
#
# The firmware itself does not read this file. The DeepSeek key is stored in the
# device's NVS by the phone setup page (SoftAP -> http://192.168.4.1). These
# values document the developer environment and are read by the developer tools.

# DeepSeek key used for generating a fresh 100-word pack while online.
# Never commit a real key. Prefer entering it on the device setup page.
DEEPSEEK_API_KEY=sk-replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat

# Optional progress-sync endpoint. Leave empty to keep progress device-local.
# The device POSTs LSPROG text to this URL and merges the reply.
LANGSTUDY_SYNC_URL=

# tools/langstudy_sync_server.py settings.
LANGSTUDY_SYNC_HOST=0.0.0.0
LANGSTUDY_SYNC_PORT=8080
LANGSTUDY_SYNC_STORE=tools/var/sync-store
